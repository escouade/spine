{
  "name": "@spinejs/http-gateway",
  "version": "0.1.5",
  "description": "HTTP gateway for SpineJS built on Hono.",
  "keywords": [
    "spinejs",
    "http",
    "gateway",
    "hono"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/escouade/spine.git",
    "directory": "packages/http-gateway"
  },
  "homepage": "https://github.com/escouade/spine/tree/main/packages/http-gateway#readme",
  "bugs": "https://github.com/escouade/spine/issues",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "node ../../scripts/ensure-yarn-pack.cjs"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./testing": {
        "import": {
          "types": "./dist/testing.d.ts",
          "default": "./dist/testing.js"
        },
        "require": {
          "types": "./dist/testing.d.cts",
          "default": "./dist/testing.cjs"
        }
      }
    }
  },
  "dependencies": {
    "@hono/node-server": "^2.0.6",
    "@spinejs/core": "workspace:^",
    "@spinejs/gateway-core": "workspace:^",
    "hono": "^4.12.27",
    "zod": "^3.25.76"
  }
}
