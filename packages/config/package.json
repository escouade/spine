{
  "name": "@spinejs/config",
  "version": "0.1.0",
  "description": "Typed configuration module for SpineJS.",
  "keywords": [
    "spinejs",
    "config",
    "configuration"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/escouade/spine.git",
    "directory": "packages/config"
  },
  "homepage": "https://github.com/escouade/spine/tree/main/packages/config#readme",
  "bugs": "https://github.com/escouade/spine/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@spinejs/core": "workspace:*"
  }
}
